<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard | Alite Riddles</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f0f9ff; color: #1e293b; }
        .bento { background: white; border: 1px solid #e0f2fe; border-radius: 2.5rem; padding: 2rem; transition: all 0.3s ease; }
        .bento:hover { transform: translateY(-5px); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05); }
        .cyan-glow { box-shadow: 0 0 20px rgba(6, 182, 212, 0.2); }
        @keyframes pulse-soft { 0%, 100% { transform: scale(1); opacity: 1; } 50% { transform: scale(1.1); opacity: 0.8; } }
        .animate-pulse-soft { animation: pulse-soft 2s infinite; }
    </style>
</head>
<body class="pb-10">

    <nav class="max-w-6xl mx-auto p-8 flex justify-between items-center">
        <div class="text-2xl font-black tracking-tighter text-slate-900">ALITE<span class="text-cyan-500">.</span></div>
        <div class="flex items-center gap-4 bg-white px-4 py-2 rounded-2xl border border-slate-100 shadow-sm">
            <span class="text-sm font-bold text-slate-500">Master <%= user.username %></span>
            <div class="h-10 w-10 rounded-xl bg-cyan-500 text-white flex items-center justify-center font-black shadow-lg shadow-cyan-200">
                <%= user.username.charAt(0).toUpperCase() %>
            </div>
        </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-12 gap-6">
        
        <div class="md:col-span-8 bento bg-slate-900 text-white border-none flex flex-col justify-between min-h-[340px] relative overflow-hidden cyan-glow">
            <div class="absolute -top-10 -right-10 p-8 opacity-10 text-[12rem] font-black rotate-12 select-none">Q</div>
            <div>
                <span class="bg-cyan-500/20 text-cyan-400 px-4 py-1.5 rounded-full text-xs font-black uppercase tracking-widest border border-cyan-500/30">Campaign Active</span>
                <h2 class="text-5xl font-extrabold mt-6 mb-2 leading-tight">Conquer<br>Level <%= user.current_level %></h2>
                <p class="text-slate-400 font-medium">Global Ranking: <span class="text-cyan-400 font-black">#<%= rank %></span></p>
            </div>
            <div class="flex flex-wrap gap-4 relative z-10">
                <a href="/level-map" class="bg-cyan-500 px-8 py-4 rounded-2xl font-black text-white hover:bg-cyan-400 transition shadow-xl shadow-cyan-900/40 hover:scale-105 active:scale-95">
                    🎮 OPEN MAP
                </a>
                <a href="/multiplayer" class="bg-rose-500 px-8 py-4 rounded-2xl font-black text-white hover:bg-rose-400 transition shadow-xl shadow-rose-900/40 hover:scale-105 active:scale-95">
                    ⚔️ BATTLE ARENA
                </a>
                <a href="/gauntlet" class="bg-white/10 backdrop-blur-md text-white px-8 py-4 rounded-2xl font-black hover:bg-white/20 transition border border-white/10">
                    ⏱️ GAUNTLET
                </a>
            </div>
        </div>

        <div class="md:col-span-4 bento flex flex-col justify-center text-center border-b-8 border-cyan-500">
            <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Campaign Rank</p>
            <p class="text-7xl font-black text-slate-900 tracking-tighter"><span class="text-cyan-500 text-4xl">LVL</span><%= user.current_level %></p>
            <div class="mt-4 w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                <div class="bg-cyan-500 h-full transition-all duration-700" style="width: <%= Math.min(100, (user.current_level / 10) * 10) %>%"></div>
            </div>
        </div>

        <div class="md:col-span-6 bento text-center">
            <p class="text-xs font-black text-slate-400 uppercase mb-2 tracking-widest">Total Progress</p>
            <p class="text-4xl font-black text-slate-900"><%= user.points || 0 %> <span class="text-sm text-slate-300">PTS</span></p>
        </div>

        <div class="md:col-span-6 bento text-center">
            <p class="text-xs font-black text-slate-400 uppercase mb-2 tracking-widest">Arena Status</p>
            <div class="flex items-center justify-center gap-2">
                <div class="w-3 h-3 bg-emerald-500 rounded-full animate-pulse"></div>
                <p class="text-4xl font-black text-emerald-600 uppercase tracking-tight">Ready</p>
            </div>
        </div>

        <div onclick="window.location.href='/leaderboard'" class="md:col-span-12 bento flex flex-col md:flex-row items-center justify-between group cursor-pointer border-2 border-transparent hover:border-cyan-200 relative overflow-hidden">
            
            <% if (typeof rankAlert !== 'undefined' && rankAlert) { %>
                <div class="absolute top-0 left-0 bg-rose-500 text-white text-[10px] font-black px-6 py-1.5 rounded-br-3xl shadow-lg z-10 tracking-widest animate-pulse">
                    RANK DROPPED! ⚡
                </div>
            <% } %>

            <div class="flex items-center gap-6 mb-4 md:mb-0">
                <div class="relative">
                    <div class="h-16 w-16 bg-cyan-50 rounded-3xl flex items-center justify-center text-3xl group-hover:scale-110 transition duration-300">🏆</div>
                    <% if (typeof rankAlert !== 'undefined' && rankAlert) { %>
                        <div class="absolute -top-1 -right-1 w-5 h-5 bg-rose-500 border-4 border-white rounded-full animate-pulse-soft"></div>
                    <% } %>
                </div>
                <div>
                    <h3 class="text-2xl font-black text-slate-900">Global Leaderboard</h3>
                    <p class="text-slate-400 font-bold uppercase text-xs tracking-widest">
                        <%= (typeof rankAlert !== 'undefined' && rankAlert) ? 'Someone has overtaken you! Reclaim your spot.' : 'See how you stack up against the best' %>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-slate-300 font-black text-sm hidden md:block">VIEW ALL PLAYERS</span>
                <div class="h-14 w-14 rounded-full bg-slate-900 text-white flex items-center justify-center group-hover:bg-cyan-500 transition-colors duration-300 shadow-lg">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7-7 7" />
                    </svg>
                </div>
            </div>
        </div>

    </main>

</body>
</html>