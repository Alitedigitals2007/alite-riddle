<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Hall of Fame | Alite Riddles</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f8fafc; color: #0f172a; }
        
        /* Podium Animations */
        .podium-item { transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .podium-item:hover { transform: translateY(-10px); }
        
        .glass-podium { 
            background: rgba(255, 255, 255, 0.8); 
            backdrop-filter: blur(12px); 
            border: 1px solid rgba(255, 255, 255, 0.6); 
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05);
        }

        /* Avatar Glow */
        .avatar-crown { filter: drop-shadow(0 0 10px rgba(6, 182, 212, 0.4)); }
        
        /* Custom Scrollbar for the list */
        .custom-scroll::-webkit-scrollbar { width: 4px; }
        .custom-scroll::-webkit-scrollbar-track { background: transparent; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }

        @keyframes slideUp {
            from { opacity: 0; transform: translate(-50%, 20px); }
            to { opacity: 1; transform: translate(-50%, 0); }
        }
        .animate-rank-card { animation: slideUp 0.6s ease-out forwards; }
    </style>
</head>
<body class="pb-24">

    <nav class="max-w-5xl mx-auto p-6 md:p-10 flex justify-between items-center">
        <a href="/dashboard" class="group flex items-center gap-2 bg-white px-5 py-2.5 rounded-2xl font-bold text-slate-500 hover:text-cyan-600 border border-slate-100 shadow-sm transition-all">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
            </svg>
            Dashboard
        </a>
        <div class="text-center">
            <h1 class="text-2xl font-black tracking-tighter text-slate-900">HALL OF <span class="text-cyan-500">FAME</span></h1>
            <p class="text-[10px] font-black uppercase text-slate-400 tracking-[0.3em]">Global Rankings</p>
        </div>
        <div class="w-24 hidden md:block"></div> </nav>

    <main class="max-w-4xl mx-auto px-4 md:px-6">
        
        <div class="grid grid-cols-3 gap-3 md:gap-6 items-end mt-8 mb-16 px-2">
            
            <% if(leaders[1]) { %>
            <div class="podium-item flex flex-col items-center">
                <div class="relative mb-4">
                    <div class="w-16 h-16 md:w-24 md:h-24 rounded-3xl bg-slate-100 border-4 border-white flex items-center justify-center font-black text-2xl md:text-3xl text-slate-400 shadow-xl">
                        <%= leaders[1].username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="absolute -bottom-2 -right-2 bg-slate-500 text-white w-7 h-7 md:w-9 md:h-9 rounded-full flex items-center justify-center font-black border-4 border-white text-xs">2</div>
                </div>
                <div class="w-full glass-podium rounded-t-[2rem] p-4 text-center h-28 md:h-36 flex flex-col justify-center">
                    <h3 class="font-black text-slate-800 text-xs md:text-sm truncate"><%= leaders[1].username %></h3>
                    <p class="text-cyan-600 font-black text-lg md:text-2xl">L<%= leaders[1].current_level %></p>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest"><%= leaders[1].exp %> EXP</p>
                </div>
            </div>
            <% } %>

            <% if(leaders[0]) { %>
            <div class="podium-item flex flex-col items-center z-10">
                <div class="relative mb-4">
                    <div class="absolute -top-10 md:-top-12 left-1/2 -translate-x-1/2 text-4xl md:text-5xl animate-bounce">👑</div>
                    <div class="w-20 h-20 md:w-32 md:h-32 rounded-[2.5rem] bg-cyan-500 border-4 border-white flex items-center justify-center font-black text-4xl md:text-6xl text-white shadow-2xl shadow-cyan-200 avatar-crown">
                        <%= leaders[0].username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="absolute -bottom-2 -right-2 bg-cyan-500 text-white w-9 h-9 md:w-12 md:h-12 rounded-full flex items-center justify-center font-black border-4 border-white text-sm">1</div>
                </div>
                <div class="w-full glass-podium rounded-t-[2.5rem] p-5 text-center h-40 md:h-52 flex flex-col justify-center border-cyan-100 shadow-cyan-100/50">
                    <h3 class="font-black text-slate-900 text-sm md:text-xl truncate"><%= leaders[0].username %></h3>
                    <p class="text-cyan-500 font-black text-3xl md:text-5xl leading-tight">L<%= leaders[0].current_level %></p>
                    <span class="bg-cyan-100 text-cyan-600 px-3 py-1 rounded-full text-[8px] md:text-[10px] font-black uppercase tracking-widest mt-2 inline-block mx-auto">Grandmaster</span>
                    <p class="text-[10px] font-bold text-slate-400 uppercase mt-2 tracking-widest"><%= leaders[0].exp %> EXP</p>
                </div>
            </div>
            <% } %>

            <% if(leaders[2]) { %>
            <div class="podium-item flex flex-col items-center">
                <div class="relative mb-4">
                    <div class="w-16 h-16 md:w-20 md:h-20 rounded-3xl bg-orange-50 border-4 border-white flex items-center justify-center font-black text-2xl text-orange-400 shadow-xl">
                        <%= leaders[2].username.charAt(0).toUpperCase() %>
                    </div>
                    <div class="absolute -bottom-2 -right-2 bg-orange-400 text-white w-7 h-7 md:w-8 md:h-8 rounded-full flex items-center justify-center font-black border-4 border-white text-xs">3</div>
                </div>
                <div class="w-full glass-podium rounded-t-[2rem] p-4 text-center h-24 md:h-32 flex flex-col justify-center">
                    <h3 class="font-black text-slate-800 text-xs md:text-sm truncate"><%= leaders[2].username %></h3>
                    <p class="text-cyan-600 font-black text-lg md:text-xl">L<%= leaders[2].current_level %></p>
                    <p class="text-[9px] font-bold text-slate-400 uppercase tracking-widest"><%= leaders[2].exp %> EXP</p>
                </div>
            </div>
            <% } %>
        </div>

        <div class="bg-white rounded-[2.5rem] shadow-2xl shadow-slate-200/50 border border-slate-100 overflow-hidden">
            <div class="px-8 py-6 border-b border-slate-50 flex justify-between items-center bg-slate-50/30">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Challenger</span>
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Level / Total Exp</span>
            </div>

            <div class="divide-y divide-slate-50 custom-scroll overflow-y-auto max-h-[500px]">
                <% leaders.slice(3).forEach((leader, index) => { %>
                    <div class="flex justify-between items-center px-6 py-5 md:px-8 hover:bg-cyan-50/40 transition-colors group">
                        <div class="flex items-center gap-4">
                            <span class="font-black text-slate-200 text-sm w-6">#<%= index + 4 %></span>
                            <div class="h-11 w-11 rounded-xl bg-slate-100 flex items-center justify-center font-bold text-slate-500 group-hover:scale-110 transition duration-300">
                                <%= leader.username.charAt(0).toUpperCase() %>
                            </div>
                            <div>
                                <h4 class="font-bold text-slate-800 text-sm md:text-base"><%= leader.username %></h4>
                                <% if(leader.username === user.username) { %>
                                    <span class="inline-block bg-slate-900 text-[8px] text-white px-2 py-0.5 rounded-md font-black uppercase">You</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="font-black text-slate-900 block md:inline">L<%= leader.current_level %></span>
                            <span class="text-[10px] font-black text-cyan-500 md:ml-2 uppercase"><%= leader.exp %> EXP</span>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

        <% if(userRank > 3) { %>
        <div class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[92%] max-w-4xl bg-slate-900 text-white p-5 rounded-[2rem] shadow-2xl flex justify-between items-center border border-slate-700 animate-rank-card z-50">
            <div class="flex items-center gap-4">
                <div class="h-10 w-10 rounded-xl bg-cyan-500 flex items-center justify-center font-black text-sm text-white">
                    #<%= userRank %>
                </div>
                <div>
                    <p class="text-[10px] font-black text-slate-400 uppercase leading-none mb-1">Your Ranking</p>
                    <p class="font-bold text-sm"><%= user.username %></p>
                </div>
            </div>
            <div class="flex items-center gap-6">
                <div class="text-right">
                    <p class="text-[10px] font-black text-slate-400 uppercase leading-none mb-1">Current</p>
                    <p class="font-black text-cyan-400 text-sm">Level <%= user.current_level %></p>
                </div>
                <div class="h-8 w-px bg-slate-700"></div>
                <div class="text-right">
                    <p class="text-[10px] font-black text-slate-400 uppercase leading-none mb-1">Total</p>
                    <p class="font-black text-white text-sm"><%= user.exp || 0 %> <span class="text-[10px] text-slate-500">EXP</span></p>
                </div>
            </div>
        </div>
        <% } %>

    </main>

</body>
</html>