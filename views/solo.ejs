<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Solo Mode | Alite Riddles</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f0f9ff; overflow-x: hidden; -webkit-tap-highlight-color: transparent; }
        
        /* Floating Animation for Desktop */
        @media (min-width: 768px) {
            @keyframes float { 0%, 100% { transform: translateY(0px); } 50% { transform: translateY(-10px); } }
            .floating-card { animation: float 4s ease-in-out infinite; }
        }

        /* Option Buttons */
        .option-btn { 
            background: white; border: 2px solid #e2e8f0; border-radius: 1.25rem; 
            padding: 1.25rem; font-weight: 700; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); 
            width: 100%; text-align: left; position: relative; display: flex; align-items: center;
        }
        .option-btn:active:not(:disabled) { transform: scale(0.98); background-color: #f8fafc; }
        .option-btn:hover:not(:disabled):not(:active) { border-color: #06b6d4; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05); }

        /* Result States */
        .correct { background: #cffafe !important; border-color: #06b6d4 !important; color: #083344 !important; animation: pulse-cyan 0.5s ease-in-out; }
        .wrong { background: #fee2e2 !important; border-color: #ef4444 !important; color: #7f1d1d !important; animation: shake 0.4s; }

        @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
        @keyframes pulse-cyan { 0% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.7); } 70% { box-shadow: 0 0 0 15px rgba(6, 182, 212, 0); } 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0); } }

        /* CIRCULAR CLOCK */
        .timer-container { position: absolute; top: 1rem; right: 1rem; width: 60px; height: 60px; display: flex; align-items: center; justify-content: center; z-index: 20; }
        @media (min-width: 768px) { .timer-container { width: 80px; height: 80px; top: 1.5rem; right: 1.5rem; } }
        
        .timer-svg { transform: rotate(-90deg); width: 100%; height: 100%; }
        .timer-circle-bg { fill: none; stroke: #f1f5f9; stroke-width: 6; }
        .timer-circle-prog { 
            fill: none; stroke: #06b6d4; stroke-width: 6; stroke-linecap: round; 
            stroke-dasharray: 226; stroke-dashoffset: 0; transition: stroke-dashoffset 1s linear, stroke 0.3s; 
        }
        #timerText { position: absolute; font-weight: 900; font-size: 1.1rem; color: #0f172a; }
        @media (min-width: 768px) { #timerText { font-size: 1.5rem; } }
        
        .timer-danger { stroke: #ef4444 !important; }
        .text-danger { color: #ef4444 !important; animation: heartBeat 0.5s infinite; }
        @keyframes heartBeat { 0% { transform: scale(1); } 50% { transform: scale(1.1); } 100% { transform: scale(1); } }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-slate-50">

    <nav class="p-4 md:p-6 flex justify-between items-center max-w-5xl mx-auto w-full">
        <a href="/level-map" class="bg-white px-4 py-2 rounded-xl text-slate-500 font-bold border border-slate-200 shadow-sm text-sm hover:text-cyan-600 transition">← Map</a>
        
        <div class="flex flex-col items-center">
            <span class="text-[9px] md:text-[10px] font-black uppercase text-cyan-600 tracking-widest">Question <%= qNumber %> / 10</span>
            <div class="flex gap-1 md:gap-1.5 mt-1.5">
                <% for(let i=0; i<10; i++) { %>
                    <div class="w-2 h-2 md:w-3 md:h-3 rounded-full transition-all duration-500 <%= i < qNumber ? 'bg-cyan-500 scale-110' : 'bg-slate-200' %>"></div>
                <% } %>
            </div>
        </div>

        <div class="text-right">
            <span class="text-[9px] md:text-[10px] font-black uppercase text-slate-400 block">Level</span>
            <span class="text-xl md:text-2xl font-black text-slate-900"><%= user.current_level %></span>
        </div>
    </nav>

    <main class="flex-grow flex items-center justify-center p-4 md:p-6">
        <div class="max-w-2xl w-full">
            
            <div id="gameBox" class="floating-card bg-white rounded-[2rem] md:rounded-[3rem] p-6 md:p-12 shadow-xl shadow-slate-200/50 border border-white mb-6 md:mb-10 relative overflow-hidden">
                <div class="timer-container">
                    <svg class="timer-svg" viewBox="0 0 80 80">
                        <circle class="timer-circle-bg" cx="40" cy="40" r="36"></circle>
                        <circle id="timerCircle" class="timer-circle-prog" cx="40" cy="40" r="36"></circle>
                    </svg>
                    <div id="timerText">15</div>
                </div>

                <div class="relative z-10 pr-12 md:pr-20">
                    <span class="text-cyan-500 font-bold text-xs md:text-sm tracking-tighter block mb-2">SOLO CHALLENGE</span>
                    <h2 class="text-xl md:text-3xl font-extrabold text-slate-900 leading-tight"><%= riddle.question %></h2>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 md:gap-5">
                <% ['A', 'B', 'C', 'D'].forEach(letter => { %>
                    <button onclick="checkAnswer('<%= letter %>', this)" class="option-btn group" data-choice="<%= letter %>">
                        <span class="flex-shrink-0 w-8 h-8 md:w-10 md:h-10 bg-slate-100 rounded-xl text-center leading-8 md:leading-10 font-black text-slate-500 mr-4 group-hover:bg-cyan-500 group-hover:text-white transition-colors"><%= letter %></span>
                        <span class="text-sm md:text-base font-bold text-slate-700"><%= riddle['option_' + letter.toLowerCase()] %></span>
                    </button>
                <% }) %>
            </div>

            <div id="feedback" class="mt-8 text-center font-black text-xl md:text-2xl h-12 flex items-center justify-center"></div>
            
            <button id="nextBtn" onclick="location.reload()" class="hidden mt-4 w-full bg-slate-900 text-white py-5 md:py-6 rounded-2xl md:rounded-[2rem] font-black uppercase tracking-widest hover:bg-cyan-600 transition-all shadow-lg active:scale-95">
                Continue →
            </button>
        </div>
    </main>

    <script>
        // --- SOUND ENGINE ---
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        function playSound(type) {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.connect(gain); gain.connect(audioCtx.destination);
            
            if(type === 'correct') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(523, audioCtx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                osc.start(); osc.stop(audioCtx.currentTime + 0.2);
            } else if(type === 'wrong') {
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(200, audioCtx.currentTime);
                osc.frequency.linearRampToValueAtTime(100, audioCtx.currentTime + 0.2);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                osc.start(); osc.stop(audioCtx.currentTime + 0.2);
            } else if(type === 'tick') {
                osc.type = 'sine'; osc.frequency.setValueAtTime(1200, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.01, audioCtx.currentTime);
                osc.start(); osc.stop(audioCtx.currentTime + 0.05);
            }
        }

        // --- TIMER LOGIC ---
        let timeLeft = 15;
        const totalTime = 15;
        const circumference = 226;
        let isActive = true;

        const timer = setInterval(() => {
            if (!isActive) return clearInterval(timer);
            timeLeft--;
            
            const timerText = document.getElementById('timerText');
            const circle = document.getElementById('timerCircle');
            
            timerText.innerText = timeLeft;
            circle.style.strokeDashoffset = circumference - (timeLeft / totalTime) * circumference;

            if (timeLeft <= 5) {
                circle.classList.add('timer-danger');
                timerText.classList.add('text-danger');
                playSound('tick');
            }

            if (timeLeft <= 0) handleFinish("TIME EXPIRED!");
        }, 1000);

        async function checkAnswer(choice, btn) {
            if (!isActive) return;
            isActive = false;
            document.querySelectorAll('.option-btn').forEach(b => b.disabled = true);

            try {
                const res = await fetch('/check-answer', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ riddleId: '<%= riddle.id %>', selectedOption: choice })
                });
                const data = await res.json();

                // Highlight correct one
                document.querySelectorAll('.option-btn').forEach(b => {
                    if(b.getAttribute('data-choice') === data.correctLetter) b.classList.add('correct');
                });

                if (data.success) {
                    playSound('correct');
                    document.getElementById('feedback').innerHTML = "<span class='text-cyan-600 tracking-tighter'>✨ CORRECT! +10 XP</span>";
                } else {
                    playSound('wrong');
                    btn.classList.add('wrong');
                    document.getElementById('feedback').innerHTML = "<span class='text-rose-500'>WRONG!</span>";
                }

                if (data.levelUp) {
                    document.getElementById('feedback').innerHTML = "<span class='text-cyan-700 animate-bounce'>🏆 LEVEL COMPLETE!</span>";
                }

            } catch (e) {
                document.getElementById('feedback').innerText = "Network Error!";
            } finally {
                document.getElementById('nextBtn').classList.remove('hidden');
            }
        }

        function handleFinish(msg) {
            isActive = false;
            playSound('wrong');
            document.getElementById('feedback').innerHTML = `<span class='text-rose-500'>${msg}</span>`;
            document.getElementById('nextBtn').classList.remove('hidden');
            document.querySelectorAll('.option-btn').forEach(b => b.disabled = true);
        }
    </script>
</body>
</html>